# Copy this file to ".env" and fill in your key. ".env" is gitignored.
#
# Get an API key from Google AI Studio (fastest): https://aistudio.google.com/apikey
# or from the GCP Console (enable the "Generative Language API" first, then
# APIs & Services -> Credentials -> Create API key). Both produce an "AIza..." key.

GEMINI_API_KEY=AIza-your-key-here

# Optional: override the model if your key doesn't have access to the default.
# Examples: gemini-2.5-flash (default), gemini-2.0-flash, gemini-1.5-flash
# GEMINI_MODEL=gemini-2.5-flash
